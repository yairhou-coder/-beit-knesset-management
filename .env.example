# Server
PORT=3000
NODE_ENV=development

# Database file (SQLite)
DATABASE_FILE=./data/beit-knesset.db

# Local storage for receipt PDFs downloaded from the receipt provider
RECEIPT_STORAGE_DIR=./data/receipts

# Default providers used when an organization has no explicit provider configured.
# Only "mock" ships in this repo; real providers are registered in src/integrations/registry.ts
DEFAULT_PAYMENT_PROVIDER=mock
DEFAULT_RECEIPT_PROVIDER=mock
DEFAULT_NOTIFICATION_PROVIDER=mock

# Mock provider tuning (used for end-to-end testing of failure paths)
MOCK_RECEIPT_FAILURE_RATE=0
MOCK_PAYMENT_FAILURE_RATE=0
